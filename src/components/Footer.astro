<style>
  footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    margin-top: 3rem;
    padding: 1rem 0;
    border-top: 1px solid rgba(0, 0, 0, 0.05);
