---
import BaseLayout from '../layouts/BaseLayout.astro';
const pageTitle = "";
---

<BaseLayout pageTitle={pageTitle}>

    <!-- Hero -->
    <section class="hero">
        <h2>Stanislav Troshin</h2>

        <h3>DevOps Engineer</h3>

        <p class="hero-subtitle">
            Hi there! Welcome to my website. I’m Stanislav, a DevOps engineer from Belarus.
        </p>

        <p class="hero-subtitle">
            I hope you find this website interesting. Feel free to connect with me on social networks for your next big project, potential collaborations, or simply a friendly chat.
        </p>

        <div class="hero-actions">
            <a href="/projects" class="btn primary">View Projects</a>
            <a href="/contact" class="btn secondary">Contact Me</a>
        </div>
    </section>

    <!-- Stack -->
    <section class="stack">
        <h3>Core Stack</h3>

        <div class="stack-grid">
            <span>Kubernetes</span>
            <span>Docker</span>
            <span>Terraform</span>
            <span>AWS / GCP</span>
            <span>CI/CD</span>
            <span>Linux</span>
        </div>
    </section>

    <!-- Navigation -->
    <section class="navigation">
        <div class="cards">

            <a href="/about" class="card">
                <h4>About</h4>
                <p>Experience, background, and engineering approach.</p>
            </a>

            <a href="/projects" class="card">
                <h4>Projects</h4>
                <p>Infrastructure, pipelines, automation and real cases.</p>
            </a>

            <a href="/contact" class="card">
                <h4>Contact</h4>
                <p>Reach out for collaboration or opportunities.</p>
            </a>

        </div>
    </section>

</BaseLayout>

<style>
/* ===== HERO ===== */
.hero {
  margin-top: 0.5rem;
  margin-bottom: 3rem;
}

.hero h2 {
  font-size: 2rem;
  font-weight: 600;
  margin-bottom: 0.5rem;
}

.hero h3 {
  margin-bottom: 0.25rem;
}

.hero-subtitle {
  font-size: 1.05rem;
  color: #475569;
  max-width: 70ch;
  margin-bottom: 0.5rem;
}

.hero-actions {
  margin-top: 1.0rem;
  display: flex;
  gap: 0.75rem;
  flex-wrap: wrap;
}

/* ===== BUTTONS ===== */
.btn {
  padding: 0.6rem 1.2rem;
  border-radius: 999px;
  font-size: 0.95rem;
  text-decoration: none;
  transition: all 0.2s ease;
}

.btn.primary {
  background: #2563eb;
  color: white;
}

.btn.primary:hover {
  background: #1e40af;
}

.btn.secondary {
  border: 1px solid #cbd5e1;
  color: #1e293b;
}

.btn.secondary:hover {
  background: #f1f5f9;
}

/* ===== STACK ===== */
.stack {
  margin-bottom: 3rem;
}

.stack h3 {
  font-size: 1.1rem;
  margin-bottom: 1rem;
}

.stack-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
}

.stack-grid span {
  font-size: 0.85rem;
  padding: 0.35rem 0.7rem;
  border-radius: 999px;
  background: #e2e8f0;
  color: #1e293b;
}

/* ===== CARDS ===== */
.navigation {
  margin-bottom: 1rem;
}

.cards {
  display: grid;
  gap: 1rem;
}

.card {
  display: block;
  padding: 1.25rem;
  border-radius: 1.25rem;
  text-decoration: none;
  background: #f8fafc;
  border: 1px solid #e2e8f0;
  transition: all 0.2s ease;
}

.card h4 {
  margin-bottom: 0.4rem;
  font-size: 1.05rem;
}

.card p {
  font-size: 0.9rem;
  color: #475569;
}

.card:hover {
  transform: translateY(-3px);
  border-color: #cbd5e1;
  box-shadow: 0 10px 20px -10px rgba(0,0,0,0.15);
}

/* ===== DARK MODE SUPPORT ===== */
html.dark .hero-subtitle {
  color: #94a3b8;
}

html.dark .btn.secondary {
  border-color: #334155;
  color: #e2e8f0;
}

html.dark .btn.secondary:hover {
  background: #1e293b;
}

html.dark .stack-grid span {
  background: #1e293b;
  color: #e2e8f0;
}

html.dark .card {
  background: #1e293b;
  border-color: #334155;
}

html.dark .card p {
  color: #94a3b8;
}

html.dark .card:hover {
  border-color: #475569;
}
</style>
