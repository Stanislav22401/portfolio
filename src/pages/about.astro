---
import BaseLayout from "../layouts/BaseLayout.astro";

const pageTitle = "About | ";

const profile = {
  name: "Stanislav Troshin",
  role: "DevOps Engineer",
  description: [
    "I am a DevOps engineer focused on building scalable and reliable infrastructure.",
    "My main areas of interest include automation, CI/CD pipelines, and cloud-native systems.",
    "I aim to reduce operational complexity and improve system stability through well-designed engineering solutions."
  ]
};

const skills = [
  {
    title: "Infrastructure",
    items: ["Terraform", "IaC", "Cloud Architecture"]
  },
  {
    title: "Containers",
    items: ["Docker", "Kubernetes"]
  },
  {
    title: "CI/CD",
    items: ["GitHub Actions", "GitLab CI"]
  },
  {
    title: "Cloud",
    items: ["AWS", "GCP"]
  },
  {
    title: "Systems",
    items: ["Linux", "Networking"]
  },
  {
    title: "Observability",
    items: ["Monitoring", "Logging"]
  }
];

const education = [
  {
    place: "Belarusian State University of Informatics and Radioelectronics",
    degree: "Bachelor's degree",
    field: "Software Engineering",
    period: "September 2024 — June 2028"
  },
  {
    place: "Gymnasium 39 Minsk",
    degree: "Secondary education",
    field: "Physics-Mathematics",
    grade: "9.3",
    period: "September 2013 — 2024"
  }
];
---

<BaseLayout pageTitle={pageTitle}>

  <!-- HERO -->
  <section class="hero">
    <h2>{profile.name}</h2>
    <h3>{profile.role}</h3>

    {profile.description.map(text => (
      <p class="hero-subtitle">{text}</p>
    ))}
  </section>

  <!-- SKILLS -->
  <section class="navigation">
    <h3 class="section-title">Skills & Technologies</h3>

    <div class="skill-cards">
      {skills.map(skill => (
        <div class="skill-card">
          <h4>{skill.title}</h4>

          <div class="skill-tags">
            {skill.items.map(item => (
              <span class="skill-tag">{item}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- EDUCATION -->
  <section class="navigation">
    <h3 class="section-title">Education</h3>

    <div class="cards">
      {education.map(item => (
        <div class="card education-card">
          <h4>{item.place}</h4>

          <p class="edu-line">{item.degree}</p>
          <p class="edu-line">{item.field}</p>

          {item.grade && (
            <p class="edu-line">Grade: {item.grade}</p>
          )}

          <p class="edu-period">{item.period}</p>
        </div>
      ))}
    </div>
  </section>

</BaseLayout>

<style>
/* ===== HERO (same as index) ===== */
.hero {
  margin-top: 0.5rem;
  margin-bottom: 3rem;
}

.hero h2 {
  font-size: 2rem;
  font-weight: 600;
  margin-bottom: 0.5rem;
}

.hero h3 {
  margin-bottom: 0.25rem;
}

.hero-subtitle {
  font-size: 1.05rem;
  color: #475569;
  max-width: 70ch;
  margin-bottom: 0.5rem;
}

/* ===== SECTION ===== */
.section-title {
  font-size: 1.1rem;
  margin-bottom: 1rem;
}

/* ===== SKILL CARDS (main improvement) ===== */
.skill-cards {
  display: grid;
  gap: 1rem;
}

/* более плотные карточки, чем navigation */
.skill-card {
  padding: 1rem;
  border-radius: 1rem;
  background: #f8fafc;
  border: 1px solid #e2e8f0;
}

.skill-card h4 {
  font-size: 0.95rem;
  margin-bottom: 0.5rem;
}

/* ===== TAGS (span-based, как ты просил) ===== */
.skill-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem;
}

.skill-tag {
  font-size: 0.75rem;
  padding: 0.25rem 0.6rem;
  border-radius: 999px;
  background: #e2e8f0;
  color: #1e293b;
}



/* ===== SPACING ===== */
.navigation {
  margin-bottom: 2rem;
}

/* ===== DARK MODE ===== */
html.dark .hero-subtitle {
  color: #94a3b8;
}

html.dark .skill-card {
  background: #1e293b;
  border-color: #334155;
}

html.dark .skill-tag {
  background: #334155;
  color: #e2e8f0;
}

/* ===== EDUCATION ===== */
.education-card {
  margin-bottom: 0.5rem;
}

.education-card h4 {
  margin-bottom: 0.25rem;
}

.edu-line {
  font-size: 0.9rem;
  color: #475569;
  margin-bottom: 0.2rem;
}

.edu-period {
  font-size: 0.8rem;
  color: #94a3b8;
  margin-top: 0.4rem;
}

/* dark mode */
html.dark .edu-line {
  color: #cbd5e1;
}

html.dark .edu-period {
  color: #94a3b8;
}
</style>
